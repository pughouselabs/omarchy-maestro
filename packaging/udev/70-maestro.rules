# REQUIRED: lets the user at the active local seat read and write Logitech
# hidraw nodes, so the bar widget, the settings app and the command line can
# talk to the mouse. This file grants nothing else.

# USB receivers expose the Logitech vendor ID in the USB parent attributes.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"

# Bluetooth HID++ interfaces have a 0005:046D:* HID parent instead of USB
# idVendor attributes; match that HID parent so the active seat gets access.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"
